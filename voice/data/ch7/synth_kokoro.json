},
"kokoro/sorry_plain_clean_0": {
"model": "kokoro",
"scene": "sorry",
"variant": "plain",
"seed": 0,
"text": "I'm really sorry. We've lost the front wheel from your Canyon, and that's our fault.",
"speed": 1.0,
"phonemes": "\u02ccIm \u0279\u02c8\u026a\u0259li s\u02c8\u0252\u0279i. w\u02cci\u02d0v l\u02c8\u0252st \u00f0\u0259 f\u0279\u02c8\u028cnt w\u02c8i\u02d0l f\u0279\u0252m j\u0254\u02d0 k\u02c8anj\u0259n, and \u00f0\u02c8ats \u02ccW\u0259 f\u02c8\u0254\u02d0lt.",
"sr": 24000,
"seconds": 5.025,
"wav": "data/ch7/wav/kokoro/sorry_plain_clean_0.wav"
},
"kokoro/calm_plain_clean_0": {
